{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    "explorer.excludeGitIgnore": false,
    "files.exclude": {
      "**/.agents": true,
      "**/.cache": true,
      "**/.DS_Store": true,
      "**/.eslintcache": true,
      "**/.env": true,
      "**/.git": true,
      "**/.idea": true,
      "**/.npm-cache": true,
      "**/.playwright-profile": true,
      "**/.pnpm-store": true,
      "**/.turbo": true,
      "**/.vite": true,
      "**/.vscode": true,
      "**/.yarn": true,
      "**/*.log": true,
      "**/*.local": true,
      "**/*.tgz": true,
      "**/*.tsbuildinfo": true,
      "**/build": true,
      "**/coverage": true,
      "**/dist": true,
      "**/logs": true,
      "**/node_modules": true,
      "**/out": true,
      "compose.yml": true
    },
    "LineCount.includes": [
      "index.html",
      "src/**/*",
      "packages/secondpass-client/src/**/*"
    ],
    "LineCount.excludes": [
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/vite-env.d.ts",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.log"
    ],
    "LineCount.showStatusBarItem": true,
    "LineCount.output": {
      "txt": true,
      "json": false,
      "csv": false,
      "md": false,
      "outdir": ".linecount"
    },
    "LineCount.sort": "filename",
    "LineCount.order": "asc"
  },
  "extensions": {
    "recommendations": [
      "yycalm.linecount"
    ]
  }
}
