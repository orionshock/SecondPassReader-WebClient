{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "explorer.excludeGitIgnore": false,
    "files.exclude": {
      "**/.agents": true,
      "**/.cache": true,
      "**/.DS_Store": true,
      "**/.eslintcache": true,
      "**/.env": true,
      "**/.git": true,
      "**/.idea": true,
      "**/.playwright-profile": true,
      "**/.pnpm-store": true,
      "**/.turbo": true,
      "**/.vite": true,
      "**/.vscode": true,
      "**/.yarn": true,
      "**/*.log": true,
      "**/*.local": true,
      "**/*.tgz": true,
      "**/build": true,
      "**/logs": true,
      "**/out": true,
      "compose.yml": true
    },
    "repoStats.excludePatterns": [
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/vite-env.d.ts",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.log"
    ]
  },
  "extensions": {
    "recommendations": [
      "vitest.explorer",
      "mhutchie.git-graph",
      "openai.chatgpt",
      "guwidoe.vscode-repo-stats"
    ]
  }
}
