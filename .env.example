# Compose/local deployment example knobs only.
# The Vite reader app does not currently consume runtime container env vars.
# Pairing to a SecondPass Library server still happens through the app UI.

SECOND_PASS_READER_IMAGE=secondpass-reader-client:local
SECOND_PASS_READER_CONTAINER_NAME=secondpass-reader-client
SECOND_PASS_READER_HOST_PORT=8080
